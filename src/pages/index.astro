---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import ObjetCard from '../components/ObjetCard.astro';
import { numeros } from '../lib/numero';
import Dentelle from '../components/Dentelle.astro';
import { getCollection } from 'astro:content';
import { site, categories, wa } from '../site.config';
import { dispo, photosDispo } from '../lib/photo';

const tous = await getCollection('objets');
const lots = numeros(tous);
const objets = tous
  .filter((o) => o.data.statut !== 'vendu')
  .sort((a, b) => b.data.ajoute.getTime() - a.data.ajoute.getTime())
  .slice(0, 4);
const evenements = await getCollection('evenements');
const grande = 'images/nous-chez-vous/lustre-salon.webp';
const medaillon = 'images/objets/service-the-porcelaine.webp';
const photoUnivers = (id: string) => photosDispo(tous.filter((o) => o.data.categorie === id).flatMap((o) => o.data.photos))[0];
const photoVisite = 'images/objets/bureau-ancien.webp';
const lienArrivages = site.chaineWhatsapp || wa("Bonjour Mouna, pouvez-vous m'ajouter à la liste des arrivages ?");
---
<Base page="accueil" titre="Accueil" description="Brocante et art de vivre à Alençon, quartier Lancrel : mobilier, luminaires, vaisselle ancienne, pièces uniques, créations faites main et friperie. Débarras, estimation, achat et dépôt-vente.">
  <section class="frontispice">
    <div class="wrap">
      <div class="cartouche">
        <span class="eyebrow">Brocante &amp; art de vivre</span>
        <h1>Les objets du Az'art</h1>
        <p class="sous">Chaque objet a une histoire à raconter. Collectionneur, amateur de déco vintage ou simplement curieux, laissez-vous porter par le charme de l'ancien.</p>
        <div class="fleuron" aria-hidden="true"><span>❧</span></div>
        <p class="meta">Alençon, quartier Lancrel, depuis MMXXIV</p>
        <div class="actions">
          <a class="btn btn-primary" href="boutique.html">Feuilleter le catalogue</a>
          <a class="btn" href="services.html">Débarras et estimation</a>
        </div>
      </div>
      {dispo(grande) && (
        <div class="gravure-hero">
          <figure class="gravure"><div class="img"><img src={grande} alt="Lustre ancien dans un salon" /></div><figcaption>Planche I. Lustre à pampilles, salon d'apparat. Photo d'illustration.</figcaption></figure>
          {dispo(medaillon) && <figure class="gravure"><div class="img" style="aspect-ratio:1"><img src={medaillon} alt="Service à thé en porcelaine" /></div><figcaption>Planche II. Porcelaine.</figcaption></figure>}
        </div>
      )}
    </div>
  </section>

  <Dentelle />

  {objets.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Nouvelles entrées au catalogue</span>
          <h2>Derniers arrivages</h2>
        </div>
        <div class="grid">{objets.map((o) => <ObjetCard objet={o} lot={lots.get(o.id)} />)}</div>
        <div class="actions" style="justify-content:center;margin-top:40px"><a class="btn" href="boutique.html">Voir tout le catalogue</a></div>
      </div>
    </section>
  )}

  <section class="section arrivages">
    <div class="wrap">
      <span class="eyebrow">La liste des arrivages</span>
      <h2>Soyez les premiers sur les nouvelles pièces</h2>
      <p>Les plus belles trouvailles partent vite. Inscrivez-vous sur WhatsApp : Mouna vous envoie les nouveautés avant tout le monde.</p>
      <div class="actions"><a class="btn btn-primary" href={lienArrivages} target="_blank" rel="noopener">M'inscrire sur WhatsApp</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Quatre façons de chiner</h2>
        <p class="muted">La chine classique d'un côté, les créations de l'atelier de l'autre.</p>
      </div>
      <div class="univers-photo">
        {Object.entries(categories).map(([id, c], i) => {
          const ph = photoUnivers(id);
          return (
            <a href={`boutique.html#${id}`}>
              <div class="arc">{ph ? <img src={ph} alt="" loading="lazy" /> : <Illustration nom={c.illustration} label={c.nom} />}</div>
              <div class="txt"><span class="num">Chapitre {["I", "II", "III", "IV"][i]}</span><h3>{c.nom}</h3><p>{c.texte}</p></div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap visite">
      <div class="info">
        <span class="eyebrow">Passer à la boutique</span>
        <h2>Venez chiner sur place</h2>
        <p class="lettrine">Les plus belles trouvailles se découvrent en vrai. La boutique vous attend dans le quartier Lancrel, dans les anciens locaux de la fleuriste, entre meubles chinés, porcelaines et créations de l'atelier.</p>
        <dl>
          <dt>Adresse</dt><dd>{site.adresse}, {site.codePostal} {site.ville}</dd>
          {site.horaires.map((h) => <><dt>{h.jours}</dt><dd>{h.heures}</dd></>)}
        </dl>
        <div class="actions">
          <a class="btn btn-primary" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.adresse + ', ' + site.codePostal + ' ' + site.ville)}`} target="_blank" rel="noopener">Itinéraire</a>
          <a class="btn" href={wa("Bonjour Mouna, je souhaite passer à la boutique. Êtes-vous ouverte ")} target="_blank" rel="noopener">Prévenir de ma visite</a>
        </div>
      </div>
      {dispo(photoVisite) && <div class="ph"><img src={photoVisite} alt="Bureau ancien" loading="lazy" /></div>}
    </div>
  </section>

  {evenements.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head" style="display:flex;justify-content:space-between;align-items:end;max-width:none;gap:20px;flex-wrap:wrap">
          <h2 style="margin:0">Prochains rendez-vous</h2>
          <a class="btn" href="evenements.html">Tous les événements</a>
        </div>
        {evenements.slice(0, 2).map((e) => (
          <div class="evt">
            <div class="date">{e.data.date}</div>
            <div><h3>{e.data.titre}</h3><p>{e.data.texte}</p>{e.data.aConfirmer && <span class="flag">Date à confirmer</span>}</div>
            <div class="muted" style="font-size:.9rem">{e.data.lieu}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <Dentelle />

  <section class="section">
    <div class="wrap split">
      <div class="panel">
        <h2>Vous videz une maison ou faites de la place&nbsp;?</h2>
        <p class="muted">Successions, déménagements, caves et greniers : nous intervenons avec soin et respect. Envoyez quelques photos, nous vous répondons rapidement.</p>
        <div class="actions">
          <a class="btn btn-primary" href="contact.html#formulaire">Envoyer des photos</a>
          <a class="btn" href="services.html">Nos services</a>
        </div>
      </div>
      <div class="panel">
        <div class="stars" aria-hidden="true">★★★★★</div>
        <h2 style="margin-top:12px">Ils sont passés en boutique</h2>
        <p class="muted">Retrouvez ce que nos visiteurs disent de la boutique sur Google, et laissez le vôtre.</p>
        <div class="actions">
          <a class="btn" href={site.avisGoogle} target="_blank" rel="noopener">Voir les avis</a>
          <a class="btn" href="nous-chez-vous.html">Nos trouvailles chez vous</a>
        </div>
      </div>
    </div>
  </section>
</Base>
