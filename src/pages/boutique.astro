---
import Base from '../layouts/Base.astro';
import ObjetCard from '../components/ObjetCard.astro';
import { numeros } from '../lib/numero';
import { getCollection } from 'astro:content';
import { categories, wa } from '../site.config';

const ordre = { disponible: 0, reserve: 1, vendu: 2 };
const tous = await getCollection('objets');
const lots = numeros(tous);
const objets = [...tous].sort(
  (a, b) => ordre[a.data.statut] - ordre[b.data.statut] || b.data.ajoute.getTime() - a.data.ajoute.getTime(),
);
---
<Base page="boutique" titre="La Boutique" description="La boutique en ligne des objets du Az'art : brocante, pièces d'exception, créations faites main et friperie vintage. Réservez par WhatsApp, retrait à Alençon.">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">La Boutique</span>
      <h1>Chiner depuis chez vous</h1>
      <p>Une pièce vous plaît ? Écrivez-nous sur WhatsApp depuis sa fiche : nous vous répondons pour la réserver, en parler ou organiser le retrait à Alençon.</p>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:80px">
    <div class="outils">
      <div class="filters" role="group" aria-label="Filtrer par univers">
        <button class="chip" type="button" data-filter="tout" aria-pressed="true">Tout</button>
        {Object.entries(categories).map(([id, c]) => (
          <button class="chip" type="button" data-filter={id} aria-pressed="false">{c.nom}</button>
        ))}
      </div>
      <div class="recherche">
        <input type="search" id="q" placeholder="Rechercher une pièce" aria-label="Rechercher une pièce" />
        <select id="tri" aria-label="Trier">
          <option value="recent">Les plus récents</option>
          <option value="az">De A à Z</option>
        </select>
      </div>
    </div>
    <div class="grid" id="grille">
      {objets.map((o) => <ObjetCard objet={o} lot={lots.get(o.id)} />)}
    </div>
    <div class="empty" id="vide" hidden>
      <p>Pas de pièce en ligne dans cet univers pour le moment.</p>
      <a class="btn btn-olive" href={wa("Bonjour Mouna, je cherche une pièce en particulier :")} target="_blank" rel="noopener">Dites-nous ce que vous cherchez</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      var chips = document.querySelectorAll('.chip');
      var grille = document.getElementById('grille');
      var cards = Array.prototype.slice.call(grille.querySelectorAll('.card'));
      var vide = document.getElementById('vide');
      var q = document.getElementById('q');
      var tri = document.getElementById('tri');
      var filtre = 'tout';
      function sansAccent(t) { return t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); }
      function apply() {
        var mot = sansAccent(q.value.trim());
        var n = 0;
        chips.forEach(function (c) { c.setAttribute('aria-pressed', String(c.dataset.filter === filtre)); });
        cards.forEach(function (c) {
          var ok = (filtre === 'tout' || c.dataset.cat === filtre) && (!mot || sansAccent(c.dataset.titre).indexOf(mot) > -1);
          c.hidden = !ok;
          if (ok) n++;
        });
        vide.hidden = n > 0;
      }
      function trier() {
        var l = cards.slice();
        if (tri.value === 'az') l.sort(function (a, b) { return a.dataset.titre.localeCompare(b.dataset.titre, 'fr'); });
        else l.sort(function (a, b) { return b.dataset.date - a.dataset.date; });
        l.forEach(function (c) { grille.appendChild(c); });
      }
      chips.forEach(function (c) {
        c.addEventListener('click', function () {
          filtre = c.dataset.filter; apply();
          try { history.replaceState(null, '', filtre === 'tout' ? location.pathname : '#' + filtre); } catch (e) {}
        });
      });
      q.addEventListener('input', apply);
      tri.addEventListener('change', function () { trier(); apply(); });
      function fromHash() {
        var h = location.hash.slice(1);
        filtre = document.querySelector('.chip[data-filter="' + h + '"]') ? h : 'tout';
        apply();
      }
      window.addEventListener('hashchange', fromHash);
      fromHash();
    })();
  </script>
</Base>
