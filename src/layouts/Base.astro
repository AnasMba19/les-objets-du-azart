---
import '../styles/global.css';
import { site, wa } from '../site.config';

interface Props { titre: string; description: string; page: string; image?: string; noindex?: boolean; lang?: string }
const { titre, description, page, noindex = false, lang = 'fr' } = Astro.props;

const nav = [
  { href: 'index.html', label: 'Accueil', id: 'accueil' },
  { href: 'boutique.html', label: 'La Boutique', id: 'boutique' },
  { href: 'services.html', label: 'Nos Services', id: 'services' },
  { href: 'nous-chez-vous.html', label: 'Nous chez Vous', id: 'nous-chez-vous' },
  ...(site.salonDeThe ? [{ href: 'salon-de-the.html', label: 'Salon de Thé', id: 'salon-de-the' }] : []),
  { href: 'evenements.html', label: 'Événements', id: 'evenements' },
  { href: 'flaneries-alencon.html', label: 'Flâneries', id: 'flaneries' },
  { href: 'contact.html', label: 'Contact', id: 'contact' },
];

const pageTitle = page === 'accueil' ? `${site.nom} | ${site.accroche}` : `${titre} | ${site.nom}, ${site.ville}`;
const canonical = new URL(Astro.url.pathname.replace(/^\//, ''), site.url + '/').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: site.nom,
  description: "Brocante, créations artisanales et friperie dans le quartier Lancrel à Alençon. Débarras, estimation, achat et dépôt-vente.",
  url: site.url,
  telephone: '+' + site.whatsapp,
  email: site.email,
  openingHours: ['Fr 14:30-19:00', 'Sa 10:00-12:00', 'Sa 14:00-19:00'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adresse,
    addressLocality: site.ville,
    postalCode: site.codePostal,
    addressRegion: 'Normandie',
    addressCountry: 'FR',
  },
};
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="fr" href={`${site.url}/index.html`} />
  <link rel="alternate" hreflang="en" href={`${site.url}/english.html`} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content={site.nom} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#efe3c8" />
  <script is:inline>try{if(localStorage.getItem("azart-theme")==="veillee")document.documentElement.dataset.theme="veillee"}catch(e){}</script>
  <link rel="icon" href="favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=IM+Fell+English+SC&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  {site.bandeauExemples && (
    <div class="banner">Site en préparation : les objets présentés sont des exemples, le catalogue arrive bientôt.</div>
  )}
  <header class="header">
    <div class="wrap">
      <a class="logo" href="index.html">
        <strong>{site.nom}</strong>
        <span>Brocante &amp; art de vivre</span>
      </a>
      <nav class="nav" aria-label="Navigation principale">
        {nav.map((n) => <a href={n.href} aria-current={n.id === page ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="header-tools">
        <button class="theme-btn" type="button" id="theme-btn" aria-label="Changer l'ambiance"><span aria-hidden="true">☾</span><span class="txt">Veillée</span></button>
        <a class="lang" href="english.html" hreflang="en" lang="en">EN</a>
        <button class="sel-btn" type="button" data-ouvrir-selection aria-label="Ma sélection">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
          <span data-compte>0</span>
        </button>
      <details class="menu">
        <summary>Menu</summary>
        <div class="menu-panel">
          {nav.map((n) => <a href={n.href} aria-current={n.id === page ? 'page' : undefined}>{n.label}</a>)}
        </div>
      </details>
      </div>
    </div>
  </header>

  <main id="contenu">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <h4>{site.nom}</h4>
          <p>Brocante, créations faites main et friperie à {site.ville}, quartier {site.quartier}. Chaque objet a une histoire à raconter.</p>
          <p>{site.adresse}<br />{site.codePostal} {site.ville}</p>
        </div>
        <div>
          <h4>Visiter</h4>
          <a href="boutique.html">La Boutique</a>
          <a href="services.html">Débarras et estimation</a>
          <a href="evenements.html">Événements</a>
          <a href="flaneries-alencon.html">Flâneries à Alençon</a>
          <a href="english.html" lang="en">In English</a>
          <a href="contact.html">Nous trouver</a>
        </div>
        <div>
          <h4>Contact</h4>
          <a href={wa('Bonjour Mouna,')} target="_blank" rel="noopener">WhatsApp : {site.telephone}</a>
          <a href={`tel:+${site.whatsapp}`}>Téléphone : {site.telephone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.instagram && <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>}
          {site.facebook && <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>}
        </div>
      </div>
      <div class="legal">© {new Date().getFullYear()} {site.nom}, {site.ville}. Tous droits réservés. <a href="credits.html" style="display:inline;margin-left:14px">Crédits photos</a></div>
    </div>
  </footer>

  <aside class="selection" id="selection" aria-label="Ma sélection" aria-hidden="true">
    <div class="tete"><h2>Ma sélection</h2><button type="button" data-fermer-selection>Fermer</button></div>
    <ul id="selection-liste"></ul>
    <div class="pied">
      <p class="muted" style="font-size:.9rem">Envoyez votre sélection à Mouna : elle vous répond sur la disponibilité de chaque pièce.</p>
      <a class="btn btn-primary" id="selection-envoyer" target="_blank" rel="noopener" href={`https://wa.me/${site.whatsapp}`}>Envoyer sur WhatsApp</a>
    </div>
  </aside>

  <script is:inline define:vars={{ num: site.whatsapp, base: site.url }}>
    (function () {
      var CLE = 'azart-selection';
      function lire() { try { return JSON.parse(localStorage.getItem(CLE)) || []; } catch (e) { return window.__sel || []; } }
      function ecrire(l) { window.__sel = l; try { localStorage.setItem(CLE, JSON.stringify(l)); } catch (e) {} majTout(); }
      function contient(id) { return lire().some(function (x) { return x.id === id; }); }
      function basculer(id, titre) {
        var l = lire();
        if (contient(id)) l = l.filter(function (x) { return x.id !== id; });
        else l.push({ id: id, titre: titre });
        ecrire(l);
      }
      function majTout() {
        var l = lire();
        document.querySelectorAll('[data-compte]').forEach(function (e) { e.textContent = l.length; });
        document.querySelectorAll('[data-coeur]').forEach(function (b) {
          var on = contient(b.dataset.coeur);
          b.setAttribute('aria-pressed', String(on));
          var t = b.querySelector('[data-libelle]');
          if (t) t.textContent = on ? 'Dans ma sélection' : 'Ajouter à ma sélection';
        });
        var ul = document.getElementById('selection-liste');
        ul.innerHTML = '';
        if (!l.length) { ul.innerHTML = '<li class="vide">Touchez le cœur sur une pièce pour l\'ajouter ici.</li>'; }
        l.forEach(function (x) {
          var li = document.createElement('li');
          var a = document.createElement('a'); a.href = 'objet-' + x.id + '.html'; a.textContent = x.titre;
          var b = document.createElement('button'); b.type = 'button'; b.textContent = 'Retirer';
          b.addEventListener('click', function () { basculer(x.id, x.titre); });
          li.appendChild(a); li.appendChild(b); ul.appendChild(li);
        });
        var texte = 'Bonjour Mouna, voici ma sélection repérée sur le site :\n' + l.map(function (x) { return '- ' + x.titre + ' (' + base + '/objet-' + x.id + '.html)'; }).join('\n') + '\nSont-elles toujours disponibles ?';
        document.getElementById('selection-envoyer').href = 'https://wa.me/' + num + '?text=' + encodeURIComponent(texte);
      }
      var panneau = document.getElementById('selection');
      function ouvrir(o) { panneau.classList.toggle('ouvert', o); panneau.setAttribute('aria-hidden', String(!o)); }
      document.addEventListener('click', function (e) {
        var c = e.target.closest('[data-coeur]');
        if (c) { e.preventDefault(); basculer(c.dataset.coeur, c.dataset.titre); return; }
        if (e.target.closest('[data-ouvrir-selection]')) ouvrir(true);
        if (e.target.closest('[data-fermer-selection]')) ouvrir(false);
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') ouvrir(false); });
      majTout();
      var tb = document.getElementById('theme-btn');
      function libTheme() { var v = document.documentElement.dataset.theme === 'veillee'; tb.querySelector('.txt').textContent = v ? 'Jour' : 'Veillée'; tb.firstElementChild.textContent = v ? '☀' : '☾'; }
      tb.addEventListener('click', function () {
        var v = document.documentElement.dataset.theme === 'veillee';
        if (v) delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = 'veillee';
        try { localStorage.setItem('azart-theme', v ? 'jour' : 'veillee'); } catch (e) {}
        libTheme();
      });
      libTheme();
    })();
  </script>

  <div class="manicule" id="manicule" aria-hidden="true"><span>☞</span></div>
  <div class="loupe" id="loupe" aria-hidden="true"></div>
  <script is:inline>
    (function () {
      var calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // 1. Lettres des titres qui ondulent au survol
      document.querySelectorAll('h1, .section-head h2, .page-head h1').forEach(function (h) {
        if (h.dataset.onde) return;
        h.dataset.onde = '1';
        h.setAttribute('aria-label', h.textContent.trim());
        var i = 0;
        (function decoupe(n) {
          Array.prototype.slice.call(n.childNodes).forEach(function (c) {
            if (c.nodeType === 3) {
              var f = document.createDocumentFragment();
              c.textContent.split(/(\s+)/).forEach(function (mot) {
                if (!mot) return;
                if (/^\s+$/.test(mot)) { f.appendChild(document.createTextNode(mot)); return; }
                var w = document.createElement('span'); w.style.whiteSpace = 'nowrap'; w.setAttribute('aria-hidden', 'true');
                Array.from(mot).forEach(function (ch) { var s = document.createElement('span'); s.className = 'l'; s.style.setProperty('--i', i++); s.textContent = ch; w.appendChild(s); });
                f.appendChild(w);
              });
              c.replaceWith(f);
            } else if (c.nodeType === 1) decoupe(c);
          });
        })(h);
        h.classList.add('onde');
      });
      var fin = matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (calme || !fin) return;
      // 2. La main d'imprimeur qui montre le chemin
      var m = document.getElementById('manicule'), minuteur;
      function pointer(el) {
        var r = el.getBoundingClientRect();
        if (r.width === 0) return;
        var haut = !!el.closest('.header');
        m.classList.toggle('haut', haut);
        m.style.transform = haut
          ? 'translate(' + (r.left + r.width / 2 - 14) + 'px,' + (r.bottom - 2) + 'px)'
          : 'translate(' + (r.left - 42) + 'px,' + (r.top + r.height / 2 - 17) + 'px)';
        m.classList.add('vu');
        clearTimeout(minuteur);
      }
      function cacher() { clearTimeout(minuteur); minuteur = setTimeout(function () { m.classList.remove('vu'); }, 900); }
      var cibles = '.nav a, .btn, .chip, .footer a, .lang, .theme-btn, .sel-btn';
      document.addEventListener('mouseover', function (e) { var t = e.target.closest(cibles); if (t) pointer(t); });
      document.addEventListener('mouseout', function (e) { var t = e.target.closest(cibles); if (t && !t.contains(e.relatedTarget)) cacher(); });
      window.addEventListener('scroll', function () { m.classList.remove('vu'); }, { passive: true });
      var premier = document.querySelector('main .btn-primary');
      if (premier) setTimeout(function () { var r = premier.getBoundingClientRect(); if (r.top > 0 && r.bottom < innerHeight) { pointer(premier); minuteur = setTimeout(function () { m.classList.remove('vu'); }, 2600); } }, 1400);
      // 3. La loupe d'antiquaire sur les photos
      var loupe = document.getElementById('loupe'), Z = 2.3;
      document.querySelectorAll('.card-media img, .objet-media img, .gravure img').forEach(function (img) {
        img.classList.add('a-loupe');
        img.addEventListener('mouseenter', function () { loupe.style.backgroundImage = 'url("' + img.currentSrc + '")'; loupe.classList.add('vu'); });
        img.addEventListener('mouseleave', function () { loupe.classList.remove('vu'); });
        img.addEventListener('mousemove', function (e) {
          var r = img.getBoundingClientRect();
          var x = e.clientX - r.left, y = e.clientY - r.top;
          loupe.style.left = e.clientX + 'px'; loupe.style.top = e.clientY + 'px';
          var k = Math.max(r.width / (img.naturalWidth || r.width), r.height / (img.naturalHeight || r.height));
          var dw = (img.naturalWidth || r.width) * k, dh = (img.naturalHeight || r.height) * k;
          var ox = (r.width - dw) / 2, oy = (r.height - dh) / 2;
          loupe.style.backgroundSize = (dw * Z) + 'px ' + (dh * Z) + 'px';
          loupe.style.backgroundPosition = (85 - (x - ox) * Z) + 'px ' + (85 - (y - oy) * Z) + 'px';
          loupe.style.filter = getComputedStyle(img).filter;
        });
      });
    })();
  </script>

  <a class="wa-float" href={wa("Bonjour Mouna, je vous contacte depuis le site.")} target="_blank" rel="noopener" aria-label="Écrire sur WhatsApp">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.5L3 21l2-5.5A8.5 8.5 0 1 1 21 11.5z"/><path d="M8.5 9.5c.5 2.5 2.5 4.5 5 5"/></svg>
    WhatsApp
  </a>
</body>
</html>
