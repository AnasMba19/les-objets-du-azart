---
import '../styles/global.css';
import { site, wa } from '../site.config';

interface Props { titre: string; description: string; page: string; image?: string; noindex?: boolean }
const { titre, description, page, noindex = false } = Astro.props;

const nav = [
  { href: 'index.html', label: 'Accueil', id: 'accueil' },
  { href: 'boutique.html', label: 'La Boutique', id: 'boutique' },
  { href: 'services.html', label: 'Nos Services', id: 'services' },
  { href: 'nous-chez-vous.html', label: 'Nous chez Vous', id: 'nous-chez-vous' },
  ...(site.salonDeThe ? [{ href: 'salon-de-the.html', label: 'Salon de Thé', id: 'salon-de-the' }] : []),
  { href: 'flaneries-alencon.html', label: 'Flâneries à Alençon', id: 'flaneries' },
  { href: 'contact.html', label: 'Contact', id: 'contact' },
];

const pageTitle = page === 'accueil' ? `${site.nom} | ${site.accroche}` : `${titre} | ${site.nom}, ${site.ville}`;
const canonical = new URL(Astro.url.pathname.replace(/^\//, ''), site.url + '/').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: site.nom,
  description: "Brocante, créations artisanales et friperie dans le quartier Lancrel à Alençon. Débarras, estimation, achat et dépôt-vente.",
  url: site.url,
  telephone: '+' + site.whatsapp,
  email: site.email,
  openingHours: ['Fr 14:30-19:00', 'Sa 10:00-12:00', 'Sa 14:00-19:00'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adresse,
    addressLocality: site.ville,
    postalCode: site.codePostal,
    addressRegion: 'Normandie',
    addressCountry: 'FR',
  },
};
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content={site.nom} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#1b1c16" />
  <link rel="icon" href="favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  {site.bandeauExemples && (
    <div class="banner">Site en préparation : les objets présentés sont des exemples, le catalogue arrive bientôt.</div>
  )}
  <header class="header">
    <div class="wrap">
      <a class="logo" href="index.html">
        <strong>{site.nom}</strong>
        <span>Brocante · Créations · Friperie</span>
      </a>
      <nav class="nav" aria-label="Navigation principale">
        {nav.map((n) => <a href={n.href} aria-current={n.id === page ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <details class="menu">
        <summary>Menu</summary>
        <div class="menu-panel">
          {nav.map((n) => <a href={n.href} aria-current={n.id === page ? 'page' : undefined}>{n.label}</a>)}
        </div>
      </details>
    </div>
  </header>

  <main id="contenu">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <h4>{site.nom}</h4>
          <p>Brocante, créations faites main et friperie à {site.ville}, quartier {site.quartier}. Chaque objet a une histoire à raconter.</p>
          <p>{site.adresse}<br />{site.codePostal} {site.ville}</p>
        </div>
        <div>
          <h4>Visiter</h4>
          <a href="boutique.html">La Boutique</a>
          <a href="services.html">Débarras et estimation</a>
          <a href="flaneries-alencon.html">Flâneries à Alençon</a>
          <a href="contact.html">Nous trouver</a>
        </div>
        <div>
          <h4>Contact</h4>
          <a href={wa('Bonjour Mouna,')} target="_blank" rel="noopener">WhatsApp : {site.telephone}</a>
          <a href={`tel:+${site.whatsapp}`}>Téléphone : {site.telephone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.instagram && <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>}
          {site.facebook && <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>}
        </div>
      </div>
      <div class="legal">© {new Date().getFullYear()} {site.nom}, {site.ville}. Tous droits réservés. · <a href="credits.html" style="display:inline">Crédits photos</a></div>
    </div>
  </footer>

  <a class="wa-float" href={wa("Bonjour Mouna, je vous contacte depuis le site.")} target="_blank" rel="noopener" aria-label="Écrire sur WhatsApp">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.5L3 21l2-5.5A8.5 8.5 0 1 1 21 11.5z"/><path d="M8.5 9.5c.5 2.5 2.5 4.5 5 5"/></svg>
    WhatsApp
  </a>
</body>
</html>
